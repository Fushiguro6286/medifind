# Copy to .env and adjust. Every value below has a working default.

# ---------------------------------------------------------------- Bright Data
# Not needed if you have run `npx -p @brightdata/cli bdata login` - the key is read
# from the CLI credentials file automatically.
# BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=cli_unlocker
BRIGHTDATA_BROWSER_ZONE=cli_browser
BRIGHTDATA_COUNTRY=in
BRIGHTDATA_TIMEOUT_MS=90000
SCRAPE_CONCURRENCY=4

# Skip the credential lookup by pinning the CDP endpoint directly.
# BRIGHTDATA_BROWSER_WS=wss://brd-customer-<id>-zone-cli_browser:<password>@brd.superproxy.io:9222

# ------------------------------------------------------------------- local LLM
# Optional. Without Ollama the app still ranks and compares - it falls back to the
# deterministic scorer and loses only the written analysis and photo search.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava
OLLAMA_TIMEOUT_MS=60000

# --------------------------------------------------------------------- refresh
REFRESH_INTERVAL_HOURS=12
REFRESH_ON_BOOT=false
# Rows below this count mark a company as drifted and trigger a Studio self-heal.
HEALTH_ROW_THRESHOLD=1
AUTO_HEAL=true
AUTO_APPROVE_HEAL=true
CACHE_TTL_MINUTES=720

# Comma-separated. Each query is scraped against all 12 companies every cycle.
# TRACKED_QUERIES=digital thermometer,blood pressure monitor,pulse oximeter

PORT=5173
